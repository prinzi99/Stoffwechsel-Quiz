{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "philipps-biohack-mcp",
      "version": "0.1.0",
      "title": "Philipp's Biohack – Stoffwechsel Tools"
    },
    "tools": [
      {
        "name": "get_stoffwechsel_quiz",
        "title": "Get Stoffwechsel Quiz",
        "description": "Returns the full 6-question Stoffwechsel-Quiz (questions + answer options with profile mapping) and the three metabolism profile definitions (A: gestresster Stoffwechsel, B: unterversorgter Fettstoffwechsel, C: überangepasster Diät-Stoffwechsel).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "evaluate_stoffwechsel_quiz",
        "title": "Evaluate Stoffwechsel Quiz",
        "description": "Given the counts of A/B/C answers picked in the Stoffwechsel-Quiz, determines the resulting metabolism profile (A, B, or C) and returns its full description. Tiebreaker priority: C > A > B.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Number of profile A answers picked."
            },
            "b": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Number of profile B answers picked."
            },
            "c": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Number of profile C answers picked."
            }
          },
          "required": [
            "a",
            "b",
            "c"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "calorie_calculator",
        "title": "Kalorienrechner (Mifflin-St Jeor + Harris-Benedict)",
        "description": "Calculates BMI, BMR (average of Mifflin-St Jeor and Harris-Benedict), TDEE, target calories, and macro split (protein / fat / carbs) for the given person. Same formulas used by Philipp's Biohack Kalorienrechner.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "gender": {
              "type": "string",
              "enum": [
                "male",
                "female"
              ]
            },
            "age": {
              "type": "integer",
              "minimum": 10,
              "maximum": 120
            },
            "weight": {
              "type": "number",
              "minimum": 20,
              "maximum": 400,
              "description": "Body weight in kg."
            },
            "height": {
              "type": "number",
              "minimum": 100,
              "maximum": 250,
              "description": "Height in cm."
            },
            "targetWeight": {
              "description": "Optional target weight in kg. Only used for protein calculation when BMI >= 30.",
              "type": "number",
              "minimum": 20,
              "maximum": 400
            },
            "activityFactor": {
              "type": "number",
              "minimum": 1,
              "maximum": 2.5,
              "description": "PAL activity factor, e.g. 1.2 sedentary, 1.375 light, 1.55 moderate, 1.725 heavy."
            },
            "goal": {
              "type": "string",
              "enum": [
                "maintenance",
                "moderate",
                "aggressive"
              ]
            },
            "proteinFactor": {
              "type": "string",
              "enum": [
                "2.0",
                "2.2",
                "2.4"
              ],
              "description": "Protein grams per kg of reference weight."
            },
            "fatMode": {
              "type": "string",
              "enum": [
                "minimum",
                "standard"
              ]
            }
          },
          "required": [
            "gender",
            "age",
            "weight",
            "height",
            "activityFactor",
            "goal",
            "proteinFactor",
            "fatMode"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "metabolism_reset_check",
        "title": "Stoffwechsel-Reset Check",
        "description": "Evaluates the 8-question Stoffwechsel-Reset Check. Pass an array of 8 booleans (index-aligned with the questions). Returns total score, level (0-2), per-area breakdown, and the matching recommendation.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "answers": {
              "minItems": 8,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "description": "Array of exactly 8 yes/no answers, one per question in the fixed order."
            }
          },
          "required": [
            "answers"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
